---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title       = 'Thadeu Alves - Desenvolvedor Web',
  description = 'Desenvolvedor Web especializado em JavaScript, React e tecnologias modernas. Crio soluções responsivas e performáticas para a web.',
} = Astro.props;

const schemaOrg = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Thadeu Alves',
  url: 'https://thadeualves.vercel.app',
  image: 'https://avatars.githubusercontent.com/u/78249846?v=4',
  jobTitle: 'Desenvolvedor Web',
  sameAs: [
    'https://www.linkedin.com/in/thadeualves/',
    'https://github.com/thadeu-alves',
  ],
};
---

<!doctype html>
<html lang="pt-br">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Thadeu Alves" />
    <meta name="theme-color" content="#8f1ef2" />
    <meta name="google-site-verification" content="0VevQZv43308qGUe7DYBLb6dUr1MZmggGZ8wBQWgCEc" />
    <link rel="canonical" href="https://thadeualves.vercel.app/" />

    <!-- Favicon -->
    <link rel="shortcut icon" href="/assets/tech/js.svg" type="image/x-icon" />
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/tech/js.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/tech/js.svg" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@100..900&display=swap"
      rel="stylesheet"
    />

    <!-- Open Graph -->
    <meta property="og:site_name" content="Thadeu Alves" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://thadeualves.vercel.app/" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://opengraph.b-cdn.net/production/images/eb90086c-4768-4ab5-b201-7b4a2518fd09.png" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="858" />
    <meta property="og:image:height" content="343" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="twitter:domain" content="thadeualves.vercel.app" />
    <meta property="twitter:url" content="https://thadeualves.vercel.app/" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://opengraph.b-cdn.net/production/images/eb90086c-4768-4ab5-b201-7b4a2518fd09.png" />

    <!-- Schema.org -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaOrg)} />
  </head>
  <body>
    <slot />
  </body>
</html>
