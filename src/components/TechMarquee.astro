---
import { techs } from '../data/techs';
const doubled = [...techs, ...techs];
---

<div class="tec-marquee-wrapper">
  <p class="marquee-eyebrow">Stack tecnológica</p>
  <div class="marquee-fade-left"></div>
  <div class="marquee-fade-right"></div>
  <div class="marquee-outer">
    <div class="marquee-track">
      {doubled.map(tech => (
        <div class="marquee-card">
          <img src={tech.img} alt={tech.name} width="64" height="64" />
          <span>{tech.name}</span>
        </div>
      ))}
    </div>
  </div>
</div>

<style>
  .tec-marquee-wrapper {
    position: relative;
    width: 100%;
    margin-bottom: 60px;
    overflow: hidden;
  }

  .marquee-eyebrow {
    text-align: center;
    font-size: 1.1rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.35);
    font-weight: 500;
    margin-bottom: 18px;
  }

  .marquee-fade-left,
  .marquee-fade-right {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 80px;
    z-index: 2;
    pointer-events: none;
  }

  .marquee-fade-left {
    left: 0;
    background: linear-gradient(to right, var(--bg-color), transparent);
  }

  .marquee-fade-right {
    right: 0;
    background: linear-gradient(to left, var(--bg-color), transparent);
  }

  .marquee-outer {
    overflow: hidden;
  }

  .marquee-track {
    display: flex;
    gap: 16px;
    width: max-content;
    animation: marquee-scroll 20s linear infinite;
  }

  .marquee-outer:hover .marquee-track {
    animation-play-state: paused;
  }

  .marquee-card {
    height: var(--tec-card-size);
    width: var(--tec-card-size);
    background-color: var(--light-color);
    border-radius: 10px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
    cursor: default;
  }

  .marquee-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(143, 30, 242, 0.35);
  }

  .marquee-card img {
    width: 64px;
    height: 64px;
    object-fit: contain;
  }

  .marquee-card span {
    font-size: 1.2rem;
    font-weight: 600;
    color: #333;
  }

  @media (max-width: 480px) {
    :root {
      --tec-card-size: 100px;
    }

    .marquee-card img {
      width: 44px;
      height: 44px;
    }

    .marquee-card span {
      font-size: 1rem;
    }
  }

  @media (max-width: 320px) {
    :root {
      --tec-card-size: 80px;
    }
  }
</style>
