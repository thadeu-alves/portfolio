---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Typewriter from '../components/Typewriter';
import TechMarquee from '../components/TechMarquee.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ExperienceCard from '../components/ExperienceCard.astro';
import EducationCard from '../components/EducationCard.astro';
import { getCollection } from 'astro:content';

const projects    = await getCollection('projects');

const rawExperiences = (await getCollection('experience')).sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
const experiences = await Promise.all(rawExperiences.map(async (exp) => {
  const { Content } = await exp.render();
  return { data: exp.data, Content };
}));

const educations = (await getCollection('education')).sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
---

<Layout>
  <Navbar />

  <main>
    <!-- ── HERO ── -->
    <section class="profile" id="home">
      <div class="info">
        <h1 class="title">Thadeu Alves</h1>
        <Typewriter client:load />
        <a href="#contato">
          <div>Minhas Redes Sociais</div>
          <div class="cta-hover">Github e Linkedin</div>
        </a>
      </div>
      <div class="img">
        <img
          src="https://avatars.githubusercontent.com/u/78249846?v=4"
          alt="Imagem de Thadeu Alves."
          width="260"
          height="260"
        />
      </div>
    </section>

    <!-- ── TECH MARQUEE ── -->
    <TechMarquee />

    <!-- ── SOBRE ── -->
    <section class="sobre" id="sobre">
      <h3>Sobre mim</h3>
      <p>
        Desenvolvedor Full Stack com foco em SaaS e inteligência artificial,
        criando soluções do zero até o lançamento em produção. Minha trajetória
        passa por plataformas de agentes de IA, sistemas omnichannel, CRMs e
        e-commerces, sempre mirando em resultados práticos para o negócio.
      </p>
      <p>
        Minha stack principal inclui TypeScript, React, Next.js e Node.js, com
        experiência prática em integrações com LLMs (OpenAI SDK), arquitetura
        de agentes, RAG e embeddings. Já estruturei produtos do zero até o
        lançamento comercial, incluindo funcionalidades de go-to-market como
        planos e assinaturas, dashboards analíticos e módulos de CRM completos.
      </p>
      <p>
        Tenho interesse especial em arquitetura de software para produtos de IA,
        experiência do usuário e soluções que geram impacto real no negócio.
        Tenho inglês C1 e estou disponível para atuar remotamente em times
        nacionais ou internacionais.
      </p>
    </section>

    <!-- ── EXPERIÊNCIA ── -->
    <section class="experiencia" id="experiencia">
      <h3>Experiência</h3>
      <div class="exp-list">
        {experiences.map(({ data, Content }) => (
          <ExperienceCard
            company={data.company}
            role={data.role}
            dateRange={data.dateRange}
            description={data.description}
            tags={data.tags}
            link={data.link}
            current={data.current}
          >
            <Content />
          </ExperienceCard>
        ))}
      </div>
    </section>

    <!-- ── EDUCAÇÃO ── -->
    <section class="educacao" id="educacao">
      <h3>Educação</h3>
      <div class="edu-list">
        {educations.map(edu => (
          <EducationCard
            institution={edu.data.institution}
            course={edu.data.course}
            dateRange={edu.data.dateRange}
            description={edu.data.description}
            tags={edu.data.tags}
            credential={edu.data.credential}
            credentialUrl={edu.data.credentialUrl}
            isCertification={edu.data.isCertification}
          />
        ))}
      </div>
    </section>

    <!-- ── PROJETOS ── -->
    <section class="projetos" id="projetos">
      <h3>Projetos</h3>
      <div class="projects">
        {projects.map(project => (
          <ProjectCard
            title={project.data.title}
            link={project.data.link}
            description={project.data.description}
            image={project.data.image}
            tags={project.data.tags}
          />
        ))}
      </div>
    </section>
  </main>

  <!-- ── FOOTER / CONTATO ── -->
  <footer id="contato">
    <div class="footer-social">
      <div class="social-card">
        <a href="https://www.linkedin.com/in/thadeualves/" target="_blank" rel="noopener">
          <img src="/assets/social/linkedin.svg" alt="Icone do Linkedin." width="50" height="50" />
        </a>
      </div>
      <div class="social-card">
        <a href="https://github.com/thadeu-alves" target="_blank" rel="noopener">
          <img src="/assets/social/github.svg" alt="Icone do Github." width="50" height="50" />
        </a>
      </div>
      <div class="social-card">
        <a href="https://www.instagram.com/thadeualves.dev/" target="_blank" rel="noopener">
          <img src="/assets/social/insta.svg" alt="Icone do Instagram." width="50" height="50" />
        </a>
      </div>
    </div>
    <div class="footer-divider"></div>
    <p class="footer-made">made with <span class="heart">&lt;3</span> by thadeu</p>
  </footer>
</Layout>

<script>
  function revealOnScroll(selector: string) {
    const items = document.querySelectorAll<HTMLElement>(selector);
    if (!items.length) return;
    const observer = new IntersectionObserver(
      entries => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('revealed');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.1 }
    );
    items.forEach((el, i) => {
      el.style.transitionDelay = `${i * 80}ms`;
      observer.observe(el);
    });
  }

  revealOnScroll('.projects .proj');
  revealOnScroll('.exp-list .exp-card');
  revealOnScroll('.edu-list .edu-card');
</script>

<style>
  /* ── MAIN ── */
  main {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin: 0 auto;
  }

  /* ── HERO ── */
  .profile {
    display: flex;
    justify-content: center;
    align-items: center;
    margin: 60px 0;
    gap: 60px;
  }

  .info {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }

  .info .title {
    font-size: 4rem;
    color: var(--medium-color);
  }

  /* CTA button */
  .info a {
    text-decoration: none;
    background-color: var(--light-color);
    padding: 8px 30px;
    border-radius: 10px;
    font-size: 2.1rem;
    cursor: pointer;
    position: relative;
    color: var(--dark-color);
    font-weight: normal;
  }

  .info a .cta-hover {
    position: absolute;
    top: 0;
    left: 0;
    background-color: var(--dark-color);
    height: 100%;
    width: 100%;
    border-radius: 10px;
    display: flex;
    justify-content: center;
    align-items: center;
    color: var(--light-color);
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .info a .cta-hover:hover {
    opacity: 1;
  }

  .img img {
    height: var(--image-size);
    width: var(--image-size);
    border-radius: 50%;
    border: 4px solid var(--light-color);
  }

  /* ── SECTION HEADINGS ── */
  .sobre h3,
  .experiencia h3,
  .educacao h3,
  .projetos h3 {
    margin-bottom: 18px;
    font-size: 1.1rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.35);
    font-weight: 500;
    text-align: center;
  }

  /* ── SOBRE ── */
  .sobre {
    width: 80%;
    display: block;
    text-align: center;
    margin-bottom: 60px;
    max-width: 768px;
  }

  .sobre p {
    margin-top: 10px;
    font-size: 2rem;
    color: var(--light-color);
  }

  /* ── EXPERIÊNCIA ── */
  .experiencia {
    width: 80%;
    max-width: 720px;
    margin-bottom: 60px;
  }

  .exp-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  /* ── EDUCAÇÃO ── */
  .educacao {
    width: 80%;
    max-width: 720px;
    margin-bottom: 60px;
  }

  .edu-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  /* ── PROJECTS ── */
  .projects {
    width: 100%;
    display: grid;
    grid-template-columns: 1fr 1fr;
    justify-content: center;
    position: relative;
    margin-bottom: 60px;
    gap: 40px;
  }

  /* ── FOOTER ── */
  footer {
    padding: 20px 0 52px;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
  }

  .footer-social {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .social-card img {
    width: var(--footer-image-size);
    height: var(--footer-image-size);
    transition: transform 0.2s ease, filter 0.2s ease;
  }

  .social-card img:hover {
    transform: translateY(-3px);
    filter: brightness(1.2);
  }

  .footer-divider {
    width: 48px;
    height: 1px;
    background: rgba(255, 255, 255, 0.12);
  }

  .footer-made {
    font-size: 1.25rem;
    color: rgba(255, 255, 255, 0.3);
    letter-spacing: 0.06em;
  }

  .footer-made .heart {
    color: #e85d8a;
    font-weight: 700;
  }

  /* ── RESPONSIVE ── */
  @media (max-width: 900px) {
    .projects {
      grid-template-columns: initial;
    }
  }

  @media (max-width: 700px) {
    :root {
      font-size: 55%;
      --proj-card-size: 390px;
    }

    .profile {
      flex-direction: column-reverse;
      gap: 24px;
    }
  }

  @media (max-width: 520px) {
    :root {
      font-size: 60%;
      --proj-card-size: 350px;
    }

    .profile {
      gap: 30px;
    }

    .experiencia,
    .educacao,
    .sobre {
      width: 90%;
    }
  }

  @media (max-width: 480px) {
    :root {
      font-size: 60%;
      --proj-card-size: 350px;
      --image-size: 200px;
    }

    .projects {
      padding: 0 24px;
    }
  }

  @media (max-width: 320px) {
    :root {
      font-size: 40%;
      --proj-card-size: 250px;
      --image-size: 150px;
    }

    .profile {
      gap: 5px;
    }
  }
</style>
