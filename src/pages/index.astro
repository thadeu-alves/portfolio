---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Typewriter from '../components/Typewriter';
import TechMarquee from '../components/TechMarquee.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');
---

<Layout>
  <Navbar />

  <main>
    <!-- ── HERO ── -->
    <section class="profile" id="home">
      <div class="info">
        <h1 class="title">Thadeu Alves</h1>
        <Typewriter client:load />
        <a href="#contato">
          <div>Minhas Redes Sociais</div>
          <div class="cta-hover">Github e Linkedin</div>
        </a>
      </div>
      <div class="img">
        <img
          src="https://avatars.githubusercontent.com/u/78249846?v=4"
          alt="Imagem de Thadeu Alves."
          width="260"
          height="260"
        />
      </div>
    </section>

    <!-- ── TECH MARQUEE ── -->
    <TechMarquee />

    <!-- ── SOBRE ── -->
    <section class="sobre" id="sobre">
      <h3>Sobre mim</h3>
      <p>
        Desenvolvedor Full Stack com foco em SaaS e inteligência artificial,
        criando soluções do zero até o lançamento em produção. Minha trajetória
        passa por plataformas de agentes de IA, sistemas omnichannel, CRMs e
        e-commerces, sempre mirando em resultados práticos para o negócio.
      </p>
      <p>
        Minha stack principal inclui TypeScript, React, Next.js e Node.js, com
        experiência prática em integrações com LLMs (OpenAI SDK), arquitetura
        de agentes, RAG e embeddings. Já estruturei produtos do zero até o
        lançamento comercial, incluindo funcionalidades de go-to-market como
        planos e assinaturas, dashboards analíticos e módulos de CRM completos.
      </p>
      <p>
        Tenho interesse especial em arquitetura de software para produtos de IA,
        experiência do usuário e soluções que geram impacto real no negócio.
        Tenho inglês C1 e estou disponível para atuar remotamente em times
        nacionais ou internacionais.
      </p>
    </section>

    <!-- ── PROJETOS ── -->
    <section class="projetos" id="projetos">
      <h3>Projetos</h3>
      <div class="projects">
        {projects.map(project => (
          <ProjectCard
            title={project.data.title}
            link={project.data.link}
            description={project.data.description}
            image={project.data.image}
            tags={project.data.tags}
          />
        ))}
      </div>
    </section>
  </main>

  <!-- ── FOOTER / CONTATO ── -->
  <footer id="contato">
    <div class="social-card">
      <a href="https://www.linkedin.com/in/thadeualves/" target="_blank" rel="noopener">
        <img src="/assets/social/linkedin.svg" alt="Icone do Linkedin." width="50" height="50" />
      </a>
    </div>
    <div class="social-card">
      <a href="https://github.com/thadeu-alves" target="_blank" rel="noopener">
        <img src="/assets/social/github.svg" alt="Icone do Github." width="50" height="50" />
      </a>
    </div>
    <div class="social-card">
      <a href="https://www.instagram.com/thadeualves.dev/" target="_blank" rel="noopener">
        <img src="/assets/social/insta.svg" alt="Icone do Instagram." width="50" height="50" />
      </a>
    </div>
  </footer>
</Layout>

<script>
  /* Scroll-reveal for project cards */
  const cards = document.querySelectorAll<HTMLElement>('.projects .proj');
  if (cards.length) {
    const observer = new IntersectionObserver(
      entries => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('revealed');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.12 }
    );
    cards.forEach((card, i) => {
      card.style.transitionDelay = `${i * 80}ms`;
      observer.observe(card);
    });
  }
</script>

<style>
  /* ── MAIN ── */
  main {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin: 0 auto;
  }

  /* ── HERO ── */
  .profile {
    display: flex;
    justify-content: center;
    align-items: center;
    margin: 60px 0;
    gap: 60px;
  }

  .info {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }

  .info .title {
    font-size: 4rem;
    color: var(--medium-color);
  }

  /* CTA button */
  .info a {
    text-decoration: none;
    background-color: var(--light-color);
    padding: 8px 30px;
    border-radius: 10px;
    font-size: 2.1rem;
    cursor: pointer;
    position: relative;
    color: var(--dark-color);
    font-weight: normal;
  }

  .info a .cta-hover {
    position: absolute;
    top: 0;
    left: 0;
    background-color: var(--dark-color);
    height: 100%;
    width: 100%;
    border-radius: 10px;
    display: flex;
    justify-content: center;
    align-items: center;
    color: var(--light-color);
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .info a .cta-hover:hover {
    opacity: 1;
  }

  .img img {
    height: var(--image-size);
    width: var(--image-size);
    border-radius: 50%;
    border: 4px solid var(--light-color);
  }

  /* ── SOBRE ── */
  .sobre {
    width: 80%;
    display: block;
    text-align: center;
    margin-bottom: 60px;
    max-width: 768px;
  }

  .sobre p {
    margin-top: 10px;
    font-size: 2rem;
    color: var(--light-color);
  }

  .sobre h3,
  .projetos h3 {
    margin-bottom: 18px;
    font-size: 1.1rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.35);
    font-weight: 500;
    text-align: center;
  }

  /* ── PROJECTS ── */
  .projects {
    width: 100%;
    display: grid;
    grid-template-columns: 1fr 1fr;
    justify-content: center;
    position: relative;
    margin-bottom: 60px;
    gap: 40px;
  }

  /* ── FOOTER ── */
  footer {
    padding-bottom: 60px;
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 20px;
  }

  .social-card img {
    width: var(--footer-image-size);
    height: var(--footer-image-size);
    transition: transform 0.2s ease, filter 0.2s ease;
  }

  .social-card img:hover {
    transform: translateY(-3px);
    filter: brightness(1.2);
  }

  /* ── RESPONSIVE ── */
  @media (max-width: 900px) {
    .projects {
      grid-template-columns: initial;
    }
  }

  @media (max-width: 700px) {
    :root {
      font-size: 55%;
      --proj-card-size: 390px;
    }

    .profile {
      flex-direction: column-reverse;
      gap: 24px;
    }
  }

  @media (max-width: 520px) {
    :root {
      font-size: 60%;
      --proj-card-size: 350px;
    }

    .profile {
      gap: 30px;
    }
  }

  @media (max-width: 480px) {
    :root {
      font-size: 60%;
      --proj-card-size: 350px;
      --image-size: 200px;
    }

    .projects {
      padding: 0 24px;
    }
  }

  @media (max-width: 320px) {
    :root {
      font-size: 40%;
      --proj-card-size: 250px;
      --image-size: 150px;
    }

    .profile {
      gap: 5px;
    }
  }
</style>
